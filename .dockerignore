# Segredo — NUNCA deve entrar no contexto de build (COPY . . copia tudo que
# não estiver aqui; sem esta linha, .env do host vazaria para dentro da imagem).
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Dependências e build — reconstruídos dentro do container, não copiados do host.
node_modules
**/node_modules
dist
**/dist
.turbo
**/.turbo
coverage
**/coverage
*.tsbuildinfo

# Prisma Client gerado localmente no host (ex.: macOS/arm64) — o binário do
# query engine é específico da plataforma. Sem esta linha, `COPY . .` levaria
# esse binário "darwin-arm64" para dentro da imagem Linux, onde é morto e só
# ocupa espaço; o estágio `build` do Dockerfile já roda `prisma generate` de
# dentro do container, gerando o client correto para o runtime de verdade.
**/prisma/generated

# Controle de versão e editor.
.git
.gitignore
.vscode
.idea
*.swp
.DS_Store

# Nada disto é necessário dentro da imagem de runtime.
docs
examples
tools
deploy/k8s
deploy/helm
.playwright-mcp
*.log

# =============================================================================
# TEMPLATE DE CONFIGURAÇÃO — copie para .env e ajuste
# Todos os valores aqui são FICTÍCIOS e servem apenas para desenvolvimento local.
# NUNCA coloque credencial real neste arquivo: ele é versionado.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=debug

# --- Kafka -------------------------------------------------------------------
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID_PREFIX=ecommerce
# Em produção: SASL_SSL + SCRAM-SHA-512 (credenciais via Secret, nunca aqui)
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_ENABLED=false

# --- Bancos (um por serviço — sem banco compartilhado) -----------------------
ORDER_DATABASE_URL=postgresql://order_svc:changeme@localhost:15432/order_db?schema=public
PAYMENT_DATABASE_URL=postgresql://payment_svc:changeme@localhost:15433/payment_db?schema=public
INVENTORY_DATABASE_URL=postgresql://inventory_svc:changeme@localhost:15434/inventory_db?schema=public
SHIPPING_DATABASE_URL=postgresql://shipping_svc:changeme@localhost:15435/shipping_db?schema=public
NOTIFICATION_DATABASE_URL=postgresql://notification_svc:changeme@localhost:15436/notification_db?schema=public

# --- Portas HTTP -------------------------------------------------------------
ORDER_SERVICE_PORT=3000
PAYMENT_SERVICE_PORT=3001
INVENTORY_SERVICE_PORT=3002
SHIPPING_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004

# --- Autenticação (dev) ------------------------------------------------------
# Em produção: chave assimétrica RS256 via Secret + rotação documentada.
JWT_SECRET=dev-only-not-a-real-secret-change-me
JWT_ISSUER=ecommerce-local
JWT_EXPIRES_IN=15m

# --- Order Service: sweeper de timeout de saga (Fase 6) ----------------------
SAGA_TIMEOUT_THRESHOLD_MS=300000
SAGA_TIMEOUT_SWEEP_INTERVAL_MS=30000

# --- Observabilidade ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_always_on

# --- SMTP fake (Mailhog) -----------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=11025
SMTP_FROM=no-reply@example.com

# --- Gateway de pagamento (mock) --------------------------------------------
# O serviço nunca persiste PAN/CVV: só o token devolvido pelo gateway.
PAYMENT_GATEWAY_URL=http://localhost:9999/mock
PAYMENT_GATEWAY_API_KEY=mock-key-not-real
